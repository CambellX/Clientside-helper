{
    "manifest_version": 3,
    "version": "1.0",
    "name": "Merriam Webster",
    "action": {
        "default_popup": "app/templates/index.html",
        "default_icon": "app/images/icon.png"
    },
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}